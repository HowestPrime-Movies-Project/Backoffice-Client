@if (ViewModel.IsOpen)
{
	<div class="modal-overlay active" id="addEventModal">
		<div class="modal-content">
			<div class="modal-header">
				<i class="fa-solid fa-clapperboard"></i>
				<h2>Add Movie Event</h2>
				<button type="button" class="modal-close-btn" @onclick="HandleClose">×</button>
			</div>
			<p class="modal-selected-date">@ViewModel.SelectedDateLabel</p>
			
			<EditForm Model="@FormModel" OnValidSubmit="@HandleValidSave" class="modal-form">
				<DataAnnotationsValidator />
				
				<div class="form-group">
					<label for="modalRoom">Room</label>
					<InputSelect id="modalRoom" class="form-control" @bind-Value="FormModel.RoomId">
						<option value="">-- Choose a Room --</option>
						@foreach (var room in ViewModel.Rooms)
						{
							<option value="@room.Value">@room.Label</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => FormModel.RoomId)" />
				</div>
				
				<div class="form-group">
					<label for="modalTime">Time</label>
					<InputSelect id="modalTime" class="form-control" @bind-Value="FormModel.Time">
						<option value="">-- Choose a Time --</option>
						@foreach (var time in ViewModel.Times)
						{
							<option value="@time">@time</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => FormModel.Time)" />
				</div>
				
				<div class="form-group">
					<label for="modalMovie">Movie</label>
					<InputSelect id="modalMovie" class="form-control" @bind-Value="FormModel.MovieId">
						<option value="">-- Choose a Movie --</option>
						@foreach (var movie in ViewModel.Movies)
						{
							<option value="@movie.Value">@movie.Label</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => FormModel.MovieId)" />
				</div>
				
				<button type="submit" class="modal-submit-btn">Save Event</button>
			</EditForm>
		</div>
	</div>

}

@code {
	[Parameter]
	public EventViewModel ViewModel { get; set; } = new();

	[Parameter]
	public EventCallback OnClose { get; set; }

	[Parameter]
	public EventCallback<ScheduleMovieEventRequest> OnSave { get; set; }

	private ScheduleMovieEventFormModel FormModel { get; set; } = new();

	private async Task HandleClose()
	{
		FormModel = new ScheduleMovieEventFormModel();
		await OnClose.InvokeAsync();
	}

	private async Task HandleValidSave()
	{
		if (!TryBuildRequest(out var request))
		{
			return;
		}

		// Invoke the save callback
		await OnSave.InvokeAsync(request);

		// Clear the form after successful submission
		FormModel = new ScheduleMovieEventFormModel();
		StateHasChanged();
	}

	private bool TryBuildRequest(out ScheduleMovieEventRequest request)
	{
		request = new ScheduleMovieEventRequest();

		if (ViewModel.SelectedDate is null ||
			!Guid.TryParse(FormModel.MovieId, out var movieId) ||
			!Guid.TryParse(FormModel.RoomId, out var roomId) ||
			string.IsNullOrWhiteSpace(FormModel.Time))
		{
			return false;
		}

		if (!TimeSpan.TryParseExact(FormModel.Time, @"hh\:mm", System.Globalization.CultureInfo.InvariantCulture, out var timeOfDay) &&
		    !TimeSpan.TryParseExact(FormModel.Time, @"h\:mm", System.Globalization.CultureInfo.InvariantCulture, out timeOfDay))
		{
			// Working with an && here for future support for other event times.
			return false;
		}

		request.MovieId = movieId;
		request.RoomId = roomId;

		// Build a proper UTC DateTime explicitly
		var dateTime = new DateTime(
			ViewModel.SelectedDate.Value.Year,
			ViewModel.SelectedDate.Value.Month,
			ViewModel.SelectedDate.Value.Day,
			timeOfDay.Hours,
			timeOfDay.Minutes,
			0,
			DateTimeKind.Utc);

		request.Showtime = new DateTimeOffset(dateTime);

		return true;
	}
}
