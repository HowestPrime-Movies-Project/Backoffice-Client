@page "/register"
@rendermode InteractiveServer
@using Howestprime.Backoffice.Components.RegisterMovie

<link rel="stylesheet" href="css/register-movie.css" />

<div class="app-container">
    <header class="app-header">
        <i class="fa-solid fa-clapperboard"></i>
        <h1>Movie Events</h1>
        <nav class="header-nav">
            <ul>
                <li><a href="/" class="active">Plan</a></li>
                <li><a href="/register" class="active">Register</a></li>
            </ul>
        </nav>
    </header>
    <main>
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success" role="alert">
                <i class="fa-solid fa-check-circle"></i>
                <span>@SuccessMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-error" role="alert">
                <i class="fa-solid fa-exclamation-circle"></i>
                <span>@ErrorMessage</span>
            </div>
        }

        <div class="register-movie-container">
            <MovieRegistrationForm RegistrationModel="@RegistrationModel" OnValidSubmit="@HandleValidSubmit" OnPosterUrlChanged="@HandlePosterUrlChanged" IsSubmitting="@IsSubmitting" />
            <MoviePosterPreview PosterUrl="@RegistrationModel.PosterUrl" />
        </div>
    </main>
</div>

